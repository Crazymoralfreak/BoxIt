{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BoxIt",
  "mainBinaryName": "BoxIt",
  "version": "0.0.2",
  "identifier": "com.crazymoralfreak.boxit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BoxIt",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost boxit: http://boxit.localhost; frame-src blob:; object-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost boxit: http://boxit.localhost ws://localhost:1420; frame-src blob:; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERTUzM0MwM0I0Q0ZEQTUKUldTbC9Vdzd3RFBsbldVOVBQUzVEMERXanY5dC9nZEdKK2JYUUVuOTZhbFYrMlhNVFdOQ24zSDMK",
      "endpoints": ["https://github.com/Crazymoralfreak/BoxIt/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["zip", "7z", "rar", "tar", "gz", "tgz", "bz2", "xz", "zst", "lz4", "cab", "iso", "wim"],
        "name": "BoxIt.Archive",
        "description": "Archive",
        "role": "Viewer"
      }
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
